          "as": "d"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 60,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "d",
          "type": "temporal"
        },
        "y": {
          "field": "val",
          "type": "quantitative"
        },
        "color": {
          "field": "dir",
          "type": "nominal",
          "scale": {
            "domain": [
              "Below Jan 2019",
              "Above Jan 2019"
            ],
            "range": [
              "#c8452d",
              "#2f7f90"
            ]
          },
          "legend": null
        }
      }
    }
  ]
}