            "dir": "Below Jan 2019"
          }
        ]
      },
      "transform": [
        {
          "calculate": "toDate(datum.date)",
          "as": "d"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 14,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "d",
          "type": "temporal"
        },
        "y": {
          "field": "ly",
          "type": "quantitative"
        },
        "text": {
          "field": "lbl"
        },
        "color": {
          "field": "dir",
          "type": "nominal",
          "scale": {
            "domain": [
              "Below Jan 2019",
              "Above Jan 2019"
            ],
            "range": [
              "#a8321d",
              "#1f6677"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
